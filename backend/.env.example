# Copy to .env and adjust. All settings are environment variables (12-factor).
APP_ENV=development            # development | production
HTTP_ADDR=:8080
DATABASE_URL=postgres://wanderplan:wanderplan@localhost:5432/wanderplan?sslmode=disable  # empty = in-memory (dev only)
AUTO_MIGRATE=true

# Auth: "dev" (local HS256 tokens) or "oidc" (production: Zitadel, Auth0, Cognito, Keycloak…)
AUTH_MODE=dev
DEV_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
# OIDC_ISSUER=https://your-tenant.zitadel.cloud
# OIDC_AUDIENCE=wanderplan-api
# OIDC_JWKS_URL=                # optional; discovered from the issuer when empty

CORS_ORIGINS=                  # only needed for browser clients
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s
MAX_BODY_BYTES=1048576
LOG_LEVEL=info

# Flight monitoring (agency design: each flight + date refreshed once per interval for everyone).
# Keys are secrets: keep them in ../secrets/*.env (git-ignored; `make run` loads them), never here.
FLIGHT_PROVIDER=               # aerodatabox | aviationstack | empty = whichever key is set
# AVIATIONSTACK_API_KEY=       # in ../secrets/aviationstack.env
# AERODATABOX_API_KEY=         # in ../secrets/aerodatabox.env
AERODATABOX_VIA=apimarket      # apimarket | rapidapi
FLIGHT_MONTHLY_BUDGET=100      # provider requests per month (match your plan)
FLIGHT_REFRESH_INTERVAL=24h    # once per flight per day
FLIGHT_DAY_OF_INTERVAL=0       # e.g. 1h for hourly checks on the day of departure (0 = off)
FLIGHT_MANUAL_COOLDOWN=30m     # shortest gap between urgent "Check now" refreshes of one flight
FLIGHT_WORKER_INTERVAL=5m      # how often the scheduler looks for due flights
REDIS_URL=                     # e.g. redis://localhost:6379/0; empty = in-process cache/lock (one instance)
