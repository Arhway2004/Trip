# Server-only settings (read by server functions; never sent to the browser).
API_BASE_URL=http://localhost:8080
# Must match the backend's AUTH_MODE / DEV_JWT_SECRET.
AUTH_MODE=dev
DEV_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars

# Client-visible settings must start with VITE_.
VITE_APP_TITLE=WanderPlan

# Optional live transport search (server-only; keep credentials out of VITE_*).
# HERE schedules need Public Transit API v8 access; fare coverage varies.
# HERE_TRANSIT_API_KEY=
# Duffel flight search only accepts a duffel_live_* token; test offers are rejected.
# DUFFEL_ACCESS_TOKEN=
